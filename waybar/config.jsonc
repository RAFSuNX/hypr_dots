// ============================================================================
// Waybar Configuration - Hyprland Rice
// ============================================================================
// Minimal border-based design with dynamic Material You theming
// ============================================================================

{
    "layer": "top",
    "position": "top",
    "height": 35,
    "spacing": 0,
    "exclusive": true,

    // ── Module Layout ───────────────────────────────────────────────────────

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "custom/netspeed",
        "clock"
    ],

    "modules-right": [
        "tray",
        "network",
        "custom/cpu",
        "memory",
        "custom/gpu",
        "pulseaudio",
        "backlight",
        "battery",
        "custom/power"
    ],

    // ── Left Modules ────────────────────────────────────────────────────────

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true
    },

    "hyprland/window": {
        "format": "▸ {}",
        "max-length": 60,
        "separate-outputs": true
    },

    // ── Center Modules──────────────────────────────────────────────────────

    "custom/netspeed": {
        "exec": "~/.config/waybar/scripts/netspeed.sh",
        "return-type": "json",
        "interval": 1
    },

    "clock": {
        "format": "{:%I:%M %p - %a %d %b}",
        "timezone": "Asia/Dhaka",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1
        }
    },

    // ── Right Modules ───────────────────────────────────────────────────────

    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu-status.sh",
        "return-type": "json",
        "interval": 3
    },

    "memory": {
        "interval": 5,
        "format": "RAM {percentage:>2}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu-status.sh",
        "return-type": "json",
        "interval": 3
    },

    "pulseaudio": {
        "format": "VOL {volume:>2}%",
        "format-muted": "VOL off",
        "on-click": "~/.config/waybar/scripts/audio-manager.sh",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "max-volume": 99,
        "tooltip": false
    },

    "backlight": {
        "format": "BRI {percent:>2}%",
        "on-scroll-up": "brightnessctl set 2%+",
        "on-scroll-down": "brightnessctl set 2%-",
        "tooltip": false
    },

    "battery": {
        "bat": "BAT1",
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "BAT {capacity:>2}%",
        "format-charging": "CHR {capacity:>2}%",
        "format-plugged": "FULL",
        "format-full": "FULL",
        "tooltip": false
    },

    "network": {
        "interface": "wlp3s0",
        "format-wifi": "NET {signalStrength:>2}%",
        "format-ethernet": "NET eth",
        "format-disconnected": "NET off",
        "tooltip-format-wifi": "{essid} {signalStrength}%\n{ipaddr}",
        "on-click": "~/.config/waybar/scripts/network-manager.sh"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    "custom/power": {
        "format": "POWER ",
        "on-click": "~/.config/waybar/scripts/power-manager.sh",
        "tooltip": false
    }
}
