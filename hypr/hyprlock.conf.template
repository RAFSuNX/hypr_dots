# ============================================================================
# Hyprlock Configuration - Auto-generated by matugen
# ============================================================================
# DO NOT EDIT hyprlock.conf MANUALLY - Edit this template instead
# Colors extracted from wallpaper using Material You algorithm
# ============================================================================

general {
    hide_cursor = true
    ignore_empty_input = false
}

# ============================================================================
# Background
# ============================================================================

background {
    monitor =
    path = screenshot
    blur_passes = 4
    blur_size = 7
    noise = 0.0117
    contrast = 0.7
    brightness = 0.5
    vibrancy = 0.1696
    vibrancy_darkness = 0.0
}

# ============================================================================
# Input Field
# ============================================================================

input-field {
    monitor =
    size = 400, 60
    outline_thickness = 1
    dots_size = 0.25
    dots_spacing = 0.3
    dots_center = true
    outer_color = rgba({{ colors.outline.default.hex_stripped }}ff)
    inner_color = rgba({{ colors.surface_container.default.hex_stripped }}ff)
    check_color = rgba({{ colors.surface_container.default.hex_stripped }}ff) rgba({{ colors.surface_container.default.hex_stripped }}ff) 0deg
    font_color = rgba({{ colors.primary.default.hex_stripped }}ff)
    fade_on_empty = false
    placeholder_text = <span foreground="##{{ colors.outline.default.hex_stripped }}">Enter Password</span>
    hide_input = false
    rounding = 0
    fail_color = rgba({{ colors.error.default.hex_stripped }}ff)
    fail_text = <span foreground="##{{ colors.error.default.hex_stripped }}">Auth Failed</span>
    capslock_color = -1
    numlock_color = -1
    bothlock_color = -1
    invert_numlock = false
    swap_font_color = false

    position = 0, -100
    halign = center
    valign = center
}

# ============================================================================
# Time Label
# ============================================================================

label {
    monitor =
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = rgb({{ colors.on_surface.default.hex_stripped }})
    font_size = 120
    font_family = JetBrainsMono Nerd Font
    position = 0, 200
    halign = center
    valign = center
}

# ============================================================================
# Date Label
# ============================================================================

label {
    monitor =
    text = cmd[update:60000] echo "$(date +'%A, %B %d')"
    color = rgb({{ colors.on_surface_variant.default.hex_stripped }})
    font_size = 24
    font_family = JetBrainsMono Nerd Font
    position = 0, 80
    halign = center
    valign = center
}

# ============================================================================
# User Label
# ============================================================================

label {
    monitor =
    text = $USER
    color = rgb({{ colors.primary.default.hex_stripped }})
    font_size = 14
    font_family = JetBrainsMono Nerd Font
    position = 0, -30
    halign = center
    valign = center
}

# ============================================================================
# End of Configuration
# ============================================================================
