/* ============================================================================
 * Rofi Theme - Auto-generated by matugen
 * ============================================================================
 * DO NOT EDIT theme.rasi MANUALLY - Edit theme.template.rasi instead
 * Colors extracted from wallpaper using Material You algorithm
 * ============================================================================
 */

* {
    /* Material You Colors */
    primary:              #ffb598;
    on-primary:           #552008;
    primary-container:    #71361c;
    on-primary-container: #ffdbce;

    secondary:            #e7beae;

    surface:              #1a110e;
    on-surface:           #f1dfd9;
    surface-container:    #271e1a;
    surface-high:         #322824;

    outline:              #a08d86;
    outline-variant:      #53433e;

    error:                #ffb4ab;

    /* Derived colors */
    background:           @surface;
    foreground:           @on-surface;
    selected-bg:          @primary-container;
    selected-fg:          @on-primary-container;
    urgent-bg:            @error;

    /* Transparency */
    background-color:     transparent;
    text-color:           @foreground;
}

/* ============================================================================
 * Window
 * ============================================================================
 */

window {
    background-color: #1a110ef2;
    transparency:    "real";
    border:           2px;
    border-color:     @primary;
    border-radius:    0px;
    width:            600px;
    padding:          0px;
    location:         center;
    anchor:           center;
}

/* ============================================================================
 * Main Box
 * ============================================================================
 */

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          0px;
    padding:          0px;
}

/* ============================================================================
 * Input Bar
 * ============================================================================
 */

inputbar {
    background-color: @surface-high;
    border:           0px 0px 2px 0px;
    border-color:     @primary;
    border-radius:    0px;
    padding:          16px 20px;
    children:         [ prompt, entry ];
    spacing:          12px;
}

prompt {
    background-color: transparent;
    text-color:       @primary;
    font:             "JetBrainsMono Nerd Font Bold 15";
}

entry {
    background-color: transparent;
    text-color:       @foreground;
    placeholder:      "Type to search...";
    placeholder-color: @outline;
    font:             "JetBrainsMono Nerd Font 15";
}

/* ============================================================================
 * Message
 * ============================================================================
 */

message {
    background-color: #322824d9;
    border:           1px;
    border-color:     @outline-variant;
    border-radius:    0px;
    padding:          10px 12px;
}

textbox {
    background-color: transparent;
    text-color:       @foreground;
}

/* ============================================================================
 * List View
 * ============================================================================
 */

listview {
    background-color: transparent;
    lines:            8;
    columns:          1;
    spacing:          0px;
    cycle:            false;
    dynamic:          false;
    scrollbar:        true;
    padding:          8px 0px;
}

/* ============================================================================
 * Elements (List Items)
 * ============================================================================
 */

element {
    background-color: transparent;
    text-color:       @foreground;
    border:           0px;
    border-color:     transparent;
    border-radius:    0px;
    padding:          14px 20px;
}

element-icon {
    background-color: transparent;
    size:             28px;
    margin:           0 12px 0 0;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}

element normal.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @primary-container;
    text-color:       @on-primary-container;
    border:           0px 0px 0px 3px;
    border-color:     @primary;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element normal.urgent {
    background-color: @urgent-bg;
    text-color:       @on-primary;
}

element selected.urgent {
    background-color: @urgent-bg;
    text-color:       @on-primary;
}

element normal.active {
    background-color: @primary-container;
    text-color:       @on-primary-container;
    border-color:     @outline-variant;
}

element selected.active {
    background-color: @primary;
    text-color:       @on-primary;
    border-color:     @primary;
}

/* ============================================================================
 * Scrollbar
 * ============================================================================
 */

scrollbar {
    background-color: transparent;
    border-radius:    0px;
    width:            4px;
    handle-width:     4px;
    handle-color:     @primary;
    padding:          8px 4px;
}

/* ============================================================================
 * End of Theme
 * ============================================================================
 */
