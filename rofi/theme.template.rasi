/* ============================================================================
 * Rofi Theme - Auto-generated by matugen
 * ============================================================================
 * DO NOT EDIT theme.rasi MANUALLY - Edit theme.template.rasi instead
 * Colors extracted from wallpaper using Material You algorithm
 * ============================================================================
 */

* {
    /* Material You Colors */
    primary:              {{ colors.primary.default.hex }};
    on-primary:           {{ colors.on_primary.default.hex }};
    primary-container:    {{ colors.primary_container.default.hex }};
    on-primary-container: {{ colors.on_primary_container.default.hex }};

    secondary:            {{ colors.secondary.default.hex }};

    surface:              {{ colors.surface.default.hex }};
    on-surface:           {{ colors.on_surface.default.hex }};
    surface-container:    {{ colors.surface_container.default.hex }};
    surface-high:         {{ colors.surface_container_high.default.hex }};

    outline:              {{ colors.outline.default.hex }};
    outline-variant:      {{ colors.outline_variant.default.hex }};

    error:                {{ colors.error.default.hex }};

    /* Derived colors */
    background:           @surface;
    foreground:           @on-surface;
    selected-bg:          @primary-container;
    selected-fg:          @on-primary-container;
    urgent-bg:            @error;

    /* Transparency */
    background-color:     transparent;
    text-color:           @foreground;
}

/* ============================================================================
 * Window
 * ============================================================================
 */

window {
    background-color: {{ colors.surface.default.hex }}99;
    transparency:    "real";
    border:           1px;
    border-color:     @outline;
    border-radius:    0px;
    width:            860px;
    padding:          0px;
    location:         center;
    anchor:           center;
}

/* ============================================================================
 * Main Box
 * ============================================================================
 */

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          0px;
}

/* ============================================================================
 * Input Bar
 * ============================================================================
 */

inputbar {
    background-color: {{ colors.surface_container_high.default.hex }}e6;
    border:           0px 0px 1px 0px;
    border-color:     @primary;
    border-radius:    0px;
    padding:          16px 20px;
    children:         [ prompt, entry ];
    spacing:          12px;
}

prompt {
    background-color: transparent;
    text-color:       @primary;
    font:             "JetBrainsMono Nerd Font Medium 14";
    vertical-align:   0.5;
}

entry {
    background-color: transparent;
    text-color:       @foreground;
    placeholder:      "Type here...";
    placeholder-color: @outline;
    font:             "JetBrainsMono Nerd Font 14";
}

/* ============================================================================
 * Message
 * ============================================================================
 */

message {
    background-color: {{ colors.surface_container_high.default.hex }}d9;
    border:           1px;
    border-color:     @outline-variant;
    border-radius:    0px;
    padding:          10px 12px;
}

textbox {
    background-color: transparent;
    text-color:       @foreground;
}

/* ============================================================================
 * List View
 * ============================================================================
 */

listview {
    background-color: transparent;
    lines:            8;
    columns:          1;
    spacing:          2px;
    cycle:            false;
    dynamic:          true;
    scrollbar:        true;
    padding:          6px 0px;
}

/* ============================================================================
 * Elements (List Items)
 * ============================================================================
 */

element {
    background-color: transparent;
    text-color:       @foreground;
    border:           0px;
    border-color:     transparent;
    border-radius:    0px;
    padding:          12px 20px;
}

element-icon {
    background-color: transparent;
    size:             32px;
    margin:           0 14px 0 0;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    font:             "JetBrainsMono Nerd Font 13";
    vertical-align:   0.5;
}

element normal.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element selected.normal {
    background-color: {{ colors.surface_container_high.default.hex }}cc;
    text-color:       @primary;
    border:           0px 0px 0px 3px;
    border-color:     @primary;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element normal.urgent {
    background-color: {{ colors.error_container.default.hex }}80;
    text-color:       @error;
    border:           0px 0px 0px 3px;
    border-color:     @error;
}

element selected.urgent {
    background-color: {{ colors.error_container.default.hex }}cc;
    text-color:       @error;
    border:           0px 0px 0px 3px;
    border-color:     @error;
}

element normal.active {
    background-color: {{ colors.primary_container.default.hex }}60;
    text-color:       @primary;
    border:           0px 0px 0px 3px;
    border-color:     @outline-variant;
}

element selected.active {
    background-color: {{ colors.primary_container.default.hex }}cc;
    text-color:       @primary;
    border:           0px 0px 0px 3px;
    border-color:     @primary;
}

/* ============================================================================
 * Scrollbar
 * ============================================================================
 */

scrollbar {
    background-color: transparent;
    border-radius:    0px;
    width:            4px;
    handle-width:     4px;
    handle-color:     @outline-variant;
    padding:          6px 3px;
}

/* ============================================================================
 * End of Theme
 * ============================================================================
 */
