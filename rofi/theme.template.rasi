/* ============================================================================
 * Rofi Theme - Auto-generated by matugen
 * ============================================================================
 * DO NOT EDIT theme.rasi MANUALLY - Edit theme.template.rasi instead
 * Colors extracted from wallpaper using Material You algorithm
 * ============================================================================
 */

* {
    /* Material You Colors */
    primary:              {{ colors.primary.default.hex }};
    on-primary:           {{ colors.on_primary.default.hex }};
    primary-container:    {{ colors.primary_container.default.hex }};
    on-primary-container: {{ colors.on_primary_container.default.hex }};

    secondary:            {{ colors.secondary.default.hex }};

    surface:              {{ colors.surface.default.hex }};
    on-surface:           {{ colors.on_surface.default.hex }};
    surface-container:    {{ colors.surface_container.default.hex }};
    surface-high:         {{ colors.surface_container_high.default.hex }};

    outline:              {{ colors.outline.default.hex }};
    outline-variant:      {{ colors.outline_variant.default.hex }};

    error:                {{ colors.error.default.hex }};

    /* Derived colors */
    background:           @surface;
    foreground:           @on-surface;
    selected-bg:          @primary-container;
    selected-fg:          @on-primary-container;
    urgent-bg:            @error;

    /* Transparency */
    background-color:     transparent;
    text-color:           @foreground;
}

/* ============================================================================
 * Window
 * ============================================================================
 */

window {
    background-color: {{ colors.surface.default.hex }}cc;
    transparency:    "real";
    border:           1px;
    border-color:     @outline;
    border-radius:    0px;
    width:            860px;
    padding:          18px;
}

/* ============================================================================
 * Main Box
 * ============================================================================
 */

mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview ];
    spacing:          14px;
}

/* ============================================================================
 * Input Bar
 * ============================================================================
 */

inputbar {
    background-color: {{ colors.surface_container.default.hex }}dd;
    border:           1px;
    border-color:     @outline-variant;
    border-radius:    0px;
    padding:          12px 16px;
    children:         [ prompt, entry ];
    spacing:          12px;
}

prompt {
    background-color: transparent;
    text-color:       @primary;
    font:             "JetBrainsMono Nerd Font Bold 15";
}

entry {
    background-color: transparent;
    text-color:       @foreground;
    placeholder:      "Type to search...";
    placeholder-color: @outline;
    font:             "JetBrainsMono Nerd Font 15";
}

/* ============================================================================
 * Message
 * ============================================================================
 */

message {
    background-color: {{ colors.surface_container_high.default.hex }}d9;
    border:           1px;
    border-color:     @outline-variant;
    border-radius:    0px;
    padding:          10px 12px;
}

textbox {
    background-color: transparent;
    text-color:       @foreground;
}

/* ============================================================================
 * List View
 * ============================================================================
 */

listview {
    background-color: transparent;
    lines:            10;
    columns:          1;
    spacing:          8px;
    cycle:            false;
    dynamic:          true;
    scrollbar:        true;
}

/* ============================================================================
 * Elements (List Items)
 * ============================================================================
 */

element {
    background-color: transparent;
    text-color:       @foreground;
    border:           1px;
    border-color:     transparent;
    border-radius:    0px;
    padding:          10px 12px;
}

element-icon {
    background-color: transparent;
    size:             28px;
    margin:           0 12px 0 0;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}

element normal.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @selected-bg;
    text-color:       @selected-fg;
    border-color:     @primary;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element normal.urgent {
    background-color: @urgent-bg;
    text-color:       @on-primary;
}

element selected.urgent {
    background-color: @urgent-bg;
    text-color:       @on-primary;
}

element normal.active {
    background-color: @primary-container;
    text-color:       @on-primary-container;
    border-color:     @outline-variant;
}

element selected.active {
    background-color: @primary;
    text-color:       @on-primary;
    border-color:     @primary;
}

/* ============================================================================
 * Scrollbar
 * ============================================================================
 */

scrollbar {
    background-color: {{ colors.surface_container.default.hex }}d9;
    border-radius:    0px;
    width:            8px;
    handle-width:     8px;
    handle-color:     @outline-variant;
}

/* ============================================================================
 * End of Theme
 * ============================================================================
 */
